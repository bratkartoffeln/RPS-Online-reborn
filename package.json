{
  "name": "rps-remake",
  "version": "0.4.34",
  "private": true,
  "type": "module",
  "description": "RPS Arena – ein eigenständiger Browser-Prototyp mit privaten Zweispieler-Partien.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts client/*.test.ts",
    "build": "npm run check && vite build && npm run build:compress-skins && tsc -p tsconfig.server.json",
    "build:compress-skins": "node scripts/compress-skin-svgs.mjs",
    "start": "node dist/server/server/index.js",
    "check:online": "node scripts/check-online.mjs",
    "check:docker": "node scripts/check-docker.mjs",
    "build:android": "npm run check && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "node scripts/build-android-apk.mjs",
    "android:open": "cap open android",
    "check:android": "node scripts/check-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@colyseus/core": "0.18.18",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "express": "^4.21.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.0",
    "playwright": "1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "ws": "8.22.0"
  }
}
