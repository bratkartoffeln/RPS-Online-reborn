# Optional. Der Server liest Umgebungsvariablen des Prozesses.
# Render setzt PORT automatisch; render.yaml setzt NODE_ENV=production.
# Im Produktionsmodus muss dist/client vor dem Start gebaut sein.
PORT=2567
HOST=0.0.0.0
RECONNECT_SECONDS=20

# Docker Compose liest die optionale Datei .env neben compose.yaml automatisch.
# Beim direkten Node-Start müssen die Werte als Prozessvariablen gesetzt werden.
# LAN-Port des Spiels auf dem NAS:
RPS_PORT=2567

# Optionaler HTTPS-Dienst: mit --profile https starten.
# Für DNS-01 zusätzlich -f compose.dns.yaml verwenden (siehe QNAP-HTTPS.md).
# Der dynv6-HTTP-Token gehört in secrets/dynv6_api_token, nicht in diese Datei.
# Nur den Domainnamen eintragen, ohne https://, Port oder Pfad.
RPS_DOMAIN=flusensieb.dns.navy
# Das sind NAS-Ports, nicht die öffentlichen Ports für den Browser.
# FRITZ!Box: extern 80/TCP -> NAS RPS_HTTP_PORT,
# extern 443/TCP -> NAS RPS_HTTPS_PORT (Standardmodus).
# DNS-Modus: extern 8443/TCP -> NAS RPS_HTTPS_PORT; RPS_HTTP_PORT wird ignoriert.
RPS_HTTP_PORT=18080
RPS_HTTPS_PORT=18443

# Im Entwicklungsmodus kann Vite diesen alternativen Server verwenden:
# VITE_SERVER_URL=http://localhost:2567

# Optional: erlaubte Browser-Ursprünge kommasepariert, jeweils ohne Schrägstrich
# am Ende. Leer erlaubt weiterhin die öffentliche Adresse und direkte LAN-URLs.
# Bei einer Einschränkung auch gewünschte LAN-Adressen samt Port aufnehmen.
# Beispiel (NAS-IP anpassen):
# ALLOWED_ORIGINS=https://flusensieb.dns.navy:8443,http://192.168.178.50:2567
ALLOWED_ORIGINS=

# Optional: eigener Ordner mit Grafiksets; fehlende Dateien fallen auf die
# eingebauten Sets zurück. Änderungen werden beim nächsten Laden sichtbar.
# Docker Compose setzt SKINS_DIR=/app/skins und bindet ./skins schreibgeschützt ein.
# Beim direkten Node-Start eine Umgebungsvariable setzen, z.B. SKINS_DIR=./skins.
# SKINS_DIR=./skins
