# Optional. Der Server liest Umgebungsvariablen des Prozesses.
# Render setzt PORT automatisch; render.yaml setzt NODE_ENV=production.
# Im Produktionsmodus muss dist/client vor dem Start gebaut sein.
PORT=2567
HOST=0.0.0.0
RECONNECT_SECONDS=120
# Im Entwicklungsmodus kann Vite diesen alternativen Server verwenden:
# VITE_SERVER_URL=http://localhost:2567
# Fuer einen oeffentlichen Host: erlaubte Browser-Urspruenge kommasepariert.
# ALLOWED_ORIGINS=https://deine-domain.example
